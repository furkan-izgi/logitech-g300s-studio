                                                       FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,5,0,0" />
                                        </Grid>
                                    </Border>
                                    <!-- Fluid RGB Spectrum Toggle -->
                                    <Border Background="{DynamicResource BrushBgSurface2}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox Grid.Row="0" x:Name="FluidRgbSettingsToggle" Style="{StaticResource PillToggleSwitch}"
                                                      Content="Fare Önizlemesinde Canlı Sıvı RGB Spektrum Dalgası"
                                                      Checked="FluidRgbSettingsToggle_Changed" Unchecked="FluidRgbSettingsToggle_Changed"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Fare yan LED'lerinde pürüzsüzce akan sıvı degrade dalgası animasyonunu çalıştırır" />
                                            <TextBlock Grid.Row="1" Text="Işıklar sekmesindeki fare yan LED'lerine akan canlı degrade ekler."
                                                       FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,5,0,0" />
                                        </Grid>
                                    </Border>
                                    <!-- G-Shift Visual & Audio Feedback Toggles -->
                                    <Border Background="{DynamicResource BrushBgSurface2}" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                <CheckBox x:Name="GShiftVisualToggle" Style="{StaticResource PillToggleSwitch}"
                                                          Content="G-Shift Görsel Rozet" IsChecked="True"
                                                          Checked="GShiftVisualToggle_Changed" Unchecked="GShiftVisualToggle_Changed"
                                                          VerticalAlignment="Center" Margin="0,0,16,0"
                                                          ToolTip="G-Shift tuşuna basıldığında ekranda katman rozetini gösterir" />
                                                <CheckBox x:Name="GShiftAudioToggle" Style="{StaticResource PillToggleSwitch}"
                                                          Content="Sesli Geri Bildirim" IsChecked="True"
                                                          Checked="GShiftAudioToggle_Changed" Unchecked="GShiftAudioToggle_Changed"
                                                          VerticalAlignment="Center"
                                                          ToolTip="G-Shift tuşuna basıldığında hafif ses tonu çalar" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="G-Shift ikincil katman tuşuna basıldığında görsel ve işitsel teyit sağlar."
                                                       FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,5,0,0" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right Column: Switch Health Analytics & System Startup -->
                        <Border Grid.Column="1" Style="{StaticResource StudioCardBorder}" Margin="10,0,0,0" Padding="24,20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <!-- Donanım Güvenliği & Optimizasyon -->
                                    <TextBlock Text="Donanım Güvenliği &amp; Sistem"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                                    <!-- Adaptive Switch Chatter Suppression -->
                                    <Border Background="{DynamicResource BrushBgSurface2}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <CheckBox x:Name="AdaptiveChatterToggle" Style="{StaticResource PillToggleSwitch}"
                                                          Content="Akıllı Uyarlamalı Çift Tıklama (Chatter) Koruması" IsChecked="True"
                                                          Checked="AdaptiveChatterToggle_Changed" Unchecked="AdaptiveChatterToggle_Changed"
                                                          VerticalAlignment="Center"
                                                          ToolTip="Aşınmış switch'lerin sıçrama (bounce) anomalilerini otomatik tespit edip süzer" />
                                                <Button Click="ResetChatterStats_Click" Style="{StaticResource ToolbarActionButton}"
                                                        Height="22" Padding="8,0" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Sıfırla" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Grid.Row="1" x:Name="ChatterStatusText"
                                                       Text="Engellenen Sıçrama: 0 tık · Risk Seviyesi: Mükemmel"
                                                       FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,5,0,0" />
                                        </Grid>
                                    </Border>

                                    <!-- Profile Backup & Restore Wizard -->
                                    <Border Background="{DynamicResource BrushBgSurface2}" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Yerel Profil Yedekleme &amp; Geri Yükleme"
                                                       FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" />
                                            <TextBlock Text="Tüm tuş atamalarını, makroları ve renkleri tek tıklamayla JSON dosyası olarak yedekleyin veya geri yükleyin."
                                                       FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,3,0,10" TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Click="ExportProfiles_Click" Style="{StaticResource ToolbarActionButton}" Height="30" Padding="14,0" Margin="0,0,10,0">
                                                    <TextBlock Text="💾 Profilleri Yedekle" FontSize="12" />
                                                </Button>
                                                <Button Click="ImportProfiles_Click" Style="{StaticResource ToolbarActionButton}" Height="30" Padding="14,0">
                                                    <TextBlock Text="📂 Yedeği Geri Yükle" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- System & Startup Options -->
                                    <TextBlock Text="Sistem &amp; Bildirimler"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                                    <Border Background="{DynamicResource BrushBgSurface2}" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="OsdToggle" Grid.Column="0" Style="{StaticResource PillToggleSwitch}"
                                                      Content="Ekran Üstü Bildirim (OSD)"
                                                      IsChecked="True"
                                                      Checked="OsdToggle_Changed" Unchecked="OsdToggle_Changed"
                                                      VerticalAlignment="Center"
                                                      ToolTip="DPI veya profil değiştiğinde ekranın üst kısmında şık bildirim gösterir" />
                                            <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource PillToggleSwitch}"
                                                      Content="Windows ile Başlat (Tepsi)"
                                                      Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Bilgisayar açıldığında uygulamayı arka planda sistem tepsisinde başlatır" />
                                        </Grid>
                                    </Border>

                                    <!-- Desktop Shortcut & Quick Utilities -->
                                    <Grid>
                                        <Button Click="CreateDesktopShortcut_Click" Style="{StaticResource ToolbarActionButton}" HorizontalAlignment="Left"
                                                ToolTip="Masaüstüne Logitech G300s Studio kısayolu ekler">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE71B;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Masaüstü Kısayolu Oluştur" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- SUBTLE FOOTER -->
                    <Border Grid.Row="1" Padding="32,0" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock x:Name="StatusFooterText"
                                       Text="Hazır"
                                       FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TelemetryEventText"
                                       Text=""
                                       FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

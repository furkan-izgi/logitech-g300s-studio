<Window x:Class="G300sController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logitech G300s"
        Width="1420" Height="850"
        MinWidth="1160" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgCanvas}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontSans}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54"
                      CornerRadius="12"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowOuterBorder"
            Background="{StaticResource BrushBgCanvas}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==================== INTEGRATED FRAMELESS HEADER ==================== -->
            <Border Grid.Row="0"
                    Background="{StaticResource BrushBgRail}"
                    BorderBrush="{StaticResource BrushBorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="22,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Clean Wordmark + Subtle Live Status -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="G300s"
                                   FontFamily="{StaticResource FontDisplay}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextPrimary}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />

                        <Border x:Name="ConnectionBadge"
                                CornerRadius="8" Padding="10,4"
                                Background="{StaticResource BrushBgSurface1}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ConnectionStatusText" Text="Bağlı"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center" />
                                <TextBlock Text="·" Foreground="{StaticResource BrushTextMuted}" Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TelemetryDpiText" Text="2000 DPI"
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Text="·" Foreground="{StaticResource BrushTextMuted}" Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TelemetryRateText" Text="1000 Hz"
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="LgsWarningBadge" Visibility="Collapsed"
                                CornerRadius="8" Padding="9,3" Margin="8,0,0,0"
                                Background="{StaticResource BrushWarningSubtle}"
                                VerticalAlignment="Center"
                                ToolTip="Logitech Gaming Software (LCore.exe) arka planda çalışıyor.">
                            <TextBlock Text="LGS Açık" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource BrushWarning}" />
                        </Border>
                    </StackPanel>

                    <!-- Center: Segmented Onboard Profile Switcher -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource BrushBgSurface1}"
                            CornerRadius="9" Padding="3"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SlotBtn0" Click="SlotButton_Click" Tag="0"
                                    Style="{StaticResource ToolbarActionButton}"
                                    Height="28" Padding="16,0" BorderThickness="0" Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SlotDot0" Width="7" Height="7" Fill="#E040FB" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Profil 1" FontSize="12.5" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SlotBtn1" Click="SlotButton_Click" Tag="1"
                                    Style="{StaticResource ToolbarActionButton}"
                                    Height="28" Padding="16,0" BorderThickness="0" Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SlotDot1" Width="7" Height="7" Fill="#00E676" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Profil 2" FontSize="12.5" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SlotBtn2" Click="SlotButton_Click" Tag="2"
                                    Style="{StaticResource ToolbarActionButton}"
                                    Height="28" Padding="16,0" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SlotDot2" Width="7" Height="7" Fill="#00D4FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Profil 3" FontSize="12.5" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Right: Clean Actions & Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Click="ImportJson_Click" Style="{StaticResource ToolbarActionButton}" Padding="11,0" Margin="0,0,5,0" ToolTip="Profil yedeğini içe aktar">
                            <TextBlock Text="İçe Aktar" />
                        </Button>
                        <Button Click="ExportJson_Click" Style="{StaticResource ToolbarActionButton}" Padding="11,0" Margin="0,0,5,0" ToolTip="Profilleri dışa aktar">
                            <TextBlock Text="Dışa Aktar" />
                        </Button>
                        <Button Click="ReloadFromMouse_Click" Style="{StaticResource ToolbarActionButton}" Width="32" Padding="0" Margin="0,0,8,0" ToolTip="Fare belleğini yeniden oku">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcons}" FontSize="12.5" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="FlashSaveBtn" Click="SaveToHardware_Click" Style="{StaticResource PrimaryAccentButton}" Margin="0,0,12,0" ToolTip="Değişiklikleri farenin yerleşik belleğine kaydet">
                            <TextBlock x:Name="FlashSaveBtnText" Text="Belleğe Kaydet" />
                        </Button>

                        <Border Width="1" Height="18" Background="{StaticResource BrushBorderSubtle}" Margin="0,0,6,0" />

                        <Button Click="MinimizeToTray_Click" Style="{StaticResource WindowCaptionButton}" ToolTip="Sistem tepsisine küçült">
                            <TextBlock Text="&#xE748;" FontFamily="{StaticResource FontIcons}" FontSize="11.5" />
                        </Button>
                        <Button Click="CaptionMinimize_Click" Style="{StaticResource WindowCaptionButton}" ToolTip="Simge durumuna küçült">
                            <TextBlock Text="&#xE921;" FontFamily="{StaticResource FontIcons}" FontSize="10" />
                        </Button>
                        <Button Click="CaptionMaximize_Click" Style="{StaticResource WindowCaptionButton}" ToolTip="Ekranı kapla">
                            <TextBlock Text="&#xE922;" FontFamily="{StaticResource FontIcons}" FontSize="10" />
                        </Button>
                        <Button Click="CaptionClose_Click" Style="{StaticResource WindowCaptionButton}" ToolTip="Kapat">
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource FontIcons}" FontSize="10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== BODY: LEFT NAV RAIL + WORKSPACE ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT NAVIGATION RAIL -->
                <Border Grid.Column="0"
                        Background="{StaticResource BrushBgRail}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="0,0,1,0"
                        Padding="0,16,0,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                            <Button x:Name="NavBtnAssignments" Click="NavRail_Click" Tag="0" Style="{StaticResource NavRailButton}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE962;" FontFamily="{StaticResource FontIcons}" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                    <TextBlock Text="Tuşlar" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnSensitivity" Click="NavRail_Click" Tag="1" Style="{StaticResource NavRailButton}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xEC4A;" FontFamily="{StaticResource FontIcons}" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                    <TextBlock Text="Sensör" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnLighting" Click="NavRail_Click" Tag="2" Style="{StaticResource NavRailButton}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE793;" FontFamily="{StaticResource FontIcons}" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                    <TextBlock Text="Işıklar" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="NavBtnAutomation" Click="NavRail_Click" Tag="3" Style="{StaticResource NavRailButton}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource FontIcons}" FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,5" />
                                    <TextBlock Text="Otomasyon" FontSize="11.5" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Click="ResetProfileDefaults_Click"
                                Style="{StaticResource NavRailButton}" Height="46" Margin="0"
                                ToolTip="Seçili profili fabrika varsayılanlarına sıfırla">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource FontIcons}" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Text="Sıfırla" FontSize="10.5" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- MAIN WORKSPACE HOST -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <!-- ==================== VIEW 0: BUTTON ASSIGNMENTS (CLEAN CENTERED STAGE + COLLAPSIBLE DRAWER) ==================== -->
                    <Grid x:Name="ViewAssignmentsGrid" Grid.Row="0" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Borderless Open Dark Spotlight Stage -->
                        <Grid Grid.Column="0" ClipToBounds="True">
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,24,0,0" IsHitTestVisible="False">
                                <TextBlock x:Name="StageActiveSlotLabel" Text="Profil 1"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextPrimary}" />
                                <TextBlock x:Name="StageSubHintText" Text="Atamasını değiştirmek istediğiniz tuşa tıklayın"
                                           FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                            </StackPanel>

                            <!-- Top-Right Preset Library & Profile Copy Bar -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,24,32,0" Panel.ZIndex="10">
                                <ComboBox x:Name="PresetTemplateCombo" Width="195" Height="30"
                                          SelectionChanged="PresetTemplateCombo_SelectionChanged"
                                          ToolTip="Seçili profile oyun veya üretkenlik şablonu uygula">
                                    <ComboBoxItem Content="Hazır Şablon Yükle..." IsSelected="True" IsEnabled="False" />
                                    <ComboBoxItem Content="FPS Rekabetçi (CS2 / Valorant)" Tag="fps" />
                                    <ComboBoxItem Content="Battle Royale (Apex / PUBG)" Tag="br" />
                                    <ComboBoxItem Content="MOBA &amp; Taktik (LoL / Dota 2)" Tag="moba" />
                                    <ComboBoxItem Content="Masaüstü &amp; Üretkenlik" Tag="productivity" />
                                </ComboBox>

                                <ComboBox x:Name="CopyProfileCombo" Width="165" Height="30" Margin="8,0,0,0"
                                          SelectionChanged="CopyProfileCombo_SelectionChanged"
                                          ToolTip="Aktif profilin tüm tuş ve DPI ayarlarını başka bir profile kopyala">
                                    <ComboBoxItem Content="Profili Kopyala →" IsSelected="True" IsEnabled="False" />
                                    <ComboBoxItem Content="→ Profil 1'e Kopyala" Tag="0" />
                                    <ComboBoxItem Content="→ Profil 2'ye Kopyala" Tag="1" />
                                    <ComboBoxItem Content="→ Profil 3'e Kopyala" Tag="2" />
                                </ComboBox>
                            </StackPanel>

                            <Viewbox Stretch="Uniform" Margin="24,36,24,14">
                                <Canvas x:Name="MouseStageCanvas" Width="1040" Height="610"
                                        Background="Transparent"
                                        MouseMove="MouseStageCanvas_MouseMove"
                                        MouseLeave="MouseStageCanvas_MouseLeave"
                                        MouseLeftButtonDown="MouseStageCanvas_MouseLeftButtonDown">

                                    <!-- Subtle Ambient Spotlight -->
                                    <Ellipse x:Name="StageSpotlightEllipse" Canvas.Left="270" Canvas.Top="50" Width="500" Height="480"
                                             IsHitTestVisible="False">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                <GradientStop x:Name="SpotlightStop0" Color="#18FFFFFF" Offset="0.0" />
                                                <GradientStop Color="#00000000" Offset="1.0" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Layer 0: Base 3D Photorealistic G300s (Offset X=135, Y=12) -->
                                    <Image x:Name="MouseBaseImage" Canvas.Left="135" Canvas.Top="12" Width="849" Height="652"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                    <!-- Layer 1: Live Tinted RGB LED Swoosh (Offset X=403, Y=262) -->
                                    <Image x:Name="MouseSwooshImage" Canvas.Left="403" Canvas.Top="262" Width="271" Height="232"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                    <!-- Layer 2: Honeycomb LED Mesh Texture -->
                                    <Image x:Name="MouseSwooshTextureImage" Canvas.Left="403" Canvas.Top="262" Width="270" Height="232"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                    <!-- Layer 3: Subtle Ambient Button Rim Glow (Offset X=195, Y=5) -->
                                    <Image x:Name="MouseAmbientGlowImage" Canvas.Left="195" Canvas.Top="5" Width="558" Height="265"
                                           Opacity="0.28" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                    <!-- Layer 4: Hovered Button Specular PulseGlow -->
                                    <Image x:Name="HoveredButtonGlowImage" Visibility="Collapsed"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                    <!-- Layer 5: Selected Button Specular PulseGlow + Translucent Highlight -->
                                    <Image x:Name="SelectedButtonGlowImage" Visibility="Collapsed"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                                    <Image x:Name="SelectedButtonHighlightImage" Visibility="Collapsed"
                                           RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                    <!-- Layer 6: Minimalist Borderless Text Callouts -->
                                    <Canvas x:Name="OverlayCalloutsCanvas" Width="1040" Height="610" />
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <!-- Collapsible Contextual Right Drawer (Hidden on startup until a button is clicked!) -->
                        <Border x:Name="InspectorDrawerBorder" Grid.Column="1" Width="340"
                                Visibility="Collapsed"
                                Background="{StaticResource BrushBgRail}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1,0,0,0"
                                Padding="22,22,22,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Selected Button Header + Close Button -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="8"
                                                    Background="{StaticResource BrushBgElevated}" Margin="0,0,12,0">
                                                <TextBlock x:Name="InspectorBtnNumberText" Text="G1"
                                                           FontFamily="{StaticResource FontDisplay}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="InspectorBtnTitleText" Text="Sol Tık"
                                                           FontFamily="{StaticResource FontDisplay}" FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushTextPrimary}" />
                                                <TextBlock x:Name="InspectorBtnSubText" Text="Tuş Ataması"
                                                           FontSize="12" Foreground="{StaticResource BrushTextMuted}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Button Click="CloseInspector_Click" Style="{StaticResource WindowCaptionButton}"
                                                Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                ToolTip="Seçimi kaldır">
                                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource FontIcons}" FontSize="10" />
                                        </Button>
                                    </Grid>

                                    <Border Margin="0,14,0,0" CornerRadius="8" Padding="14,10"
                                            Background="{StaticResource BrushBgSurface1}">
                                        <Grid>
                                            <TextBlock Text="Atanan İşlev" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                                            <TextBlock x:Name="InspectorCurrentActionText" Text="Sol Tık"
                                                       FontFamily="{StaticResource FontDisplay}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Segmented Category Filter -->
                                <Border Grid.Row="1" Background="{StaticResource BrushBgSurface1}"
                                        CornerRadius="8" Padding="3" Margin="0,0,0,14">
                                    <UniformGrid Columns="3">
                                        <Button x:Name="DrawerTabMouseBtn" Click="DrawerCategoryTab_Click" Tag="0"
                                                Style="{StaticResource ToolbarActionButton}" Height="28" Padding="4,0" BorderThickness="0" Content="Fare" />
                                        <Button x:Name="DrawerTabDpiBtn" Click="DrawerCategoryTab_Click" Tag="1"
                                                Style="{StaticResource ToolbarActionButton}" Height="28" Padding="4,0" BorderThickness="0" Content="DPI / Profil" />
                                        <Button x:Name="DrawerTabKeyBtn" Click="DrawerCategoryTab_Click" Tag="2"
                                                Style="{StaticResource ToolbarActionButton}" Height="28" Padding="4,0" BorderThickness="0" Content="Klavye / Makro" />
                                    </UniformGrid>
                                </Border>

                                <!-- Category 0: Mouse Functions -->
                                <StackPanel x:Name="DrawerPanelMouse" Grid.Row="2" Visibility="Visible">
                                    <Button Tag="mouse:1" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="Sol Tık" FontSize="13" />
                                            <TextBlock Text="Birincil" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="mouse:2" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="Sağ Tık" FontSize="13" />
                                            <TextBlock Text="İkincil" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="mouse:3" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="Orta Tık (Tekerlek)" FontSize="13" />
                                            <TextBlock Text="Fare 3" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="mouse:4" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="Geri (Fare 4)" FontSize="13" />
                                            <TextBlock Text="Gezinme" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="mouse:5" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="İleri (Fare 5)" FontSize="13" />
                                            <TextBlock Text="Gezinme" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="none" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="Devre Dışı Bırak" FontSize="13" Foreground="{StaticResource BrushTextSecondary}" />
                                            <TextBlock Text="Kapalı" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!-- Category 1: DPI & Profile Functions -->
                                <StackPanel x:Name="DrawerPanelDpi" Grid.Row="2" Visibility="Collapsed">
                                    <Button Tag="dpi-up" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="DPI Artır" FontSize="13" />
                                            <TextBlock Text="Üst Kademe" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="dpi-down" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="DPI Azalt" FontSize="13" />
                                            <TextBlock Text="Alt Kademe" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="dpi-cycle" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="DPI Döngüsü" FontSize="13" />
                                            <TextBlock Text="Kademe 1–4" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="dpi-alternate" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="DPI Shift (Basılı Tutarken Nişan)" FontSize="13" />
                                            <TextBlock Text="Geçici" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="dpi-default" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="Varsayılan DPI" FontSize="13" />
                                            <TextBlock Text="Başlangıç" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                    <Button Tag="profile-cycle" Click="QuickActionPreset_Click" Style="{StaticResource ActionRowButton}">
                                        <Grid>
                                            <TextBlock Text="Profil Değiştir" FontSize="13" />
                                            <TextBlock Text="Profil 1–3" FontSize="12" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </Button>
                                </StackPanel>

                                <!-- Category 2: Keyboard Recorder & Macro Trigger -->
                                <StackPanel x:Name="DrawerPanelKey" Grid.Row="2" Visibility="Collapsed">
                                    <TextBlock Text="Klavye Kısayolu" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,6" />
                                    <TextBlock Text="Aşağıdaki alana tıklayıp klavyeden atamak istediğiniz tuşa veya kombinasyona basın:"
                                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12" />

                                    <Button x:Name="RecordKeyBtn" Click="RecordKeyBtn_Click"
                                            PreviewKeyDown="RecordKeyBtn_PreviewKeyDown"
                                            LostFocus="RecordKeyBtn_LostFocus"
                                            Style="{StaticResource ToolbarActionButton}" Height="40" Margin="0,0,0,22">
                                        <TextBlock x:Name="RecordKeyBtnText" Text="Tuş Kaydetmek İçin Tıklayın" FontSize="12.5" FontWeight="Medium" />
                                    </Button>

                                    <TextBlock Text="Makro Bağlantısı" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBlock Text="Otomasyon bölümündeki çoklu kısayol veya seri tıklama makrolarından birini seçin:"
                                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <ComboBox x:Name="HostMacroPresetCombo" Height="34"
                                              SelectionChanged="HostMacroPresetCombo_SelectionChanged">
                                        <ComboBoxItem Content="Makro Seçin..." IsSelected="True" IsEnabled="False" />
                                        <ComboBoxItem Content="Makro 1 (F13)" Tag="key:f13" />
                                        <ComboBoxItem Content="Makro 2 (F14)" Tag="key:f14" />
                                        <ComboBoxItem Content="Makro 3 (F15 · Zamanlamalı)" Tag="key:f15" />
                                        <ComboBoxItem Content="Makro 4 (F16 · Seri Tıklama)" Tag="key:f16" />
                                        <ComboBoxItem Content="Makro 5 (F17 · Geri Tepme)" Tag="key:f17" />
                                        <ComboBoxItem Content="Makro 6 (F18 · G-Shift)" Tag="key:f18" />
                                    </ComboBox>

                                    <TextBlock Text="G-Shift İkincil Katman" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,6" />
                                    <TextBlock Text="Bu tuşa basılı tutulduğu sürece fareyi geçici olarak G-Shift profiline (varsayılan Profil 3) geçirir:"
                                               FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Button Click="AssignGShiftBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="36">
                                        <TextBlock Text="G-Shift Katman Tuşu Olarak Ata (F18)" FontSize="12.5" FontWeight="Medium" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== VIEW 1: SENSITIVITY & DPI STUDIO ==================== -->
                    <Grid x:Name="ViewSensitivityGrid" Grid.Row="0" Visibility="Collapsed" Margin="32,24,32,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header + Live Polling Rate Tester + Polling Rate Segmented Pill -->
                        <Grid Grid.Row="0" Margin="0,0,0,20">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Sensör Hassasiyeti"
                                           FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="4 yerleşik DPI kademesini grafik üzerinden sürükleyerek veya alt kademelerden ayarlayın"
                                           FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- Live Polling Rate & Jitter Tester -->
                                <Border Background="{StaticResource BrushBgSurface1}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                        CornerRadius="9" Padding="12,4" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveRateReadoutText" Text="Ölçüm: Hazır"
                                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button x:Name="ToggleRateTestBtn" Content="Hz Testi Başlat" Click="ToggleRateTestBtn_Click"
                                                Style="{StaticResource ToolbarActionButton}" Height="24" Padding="10,0" FontSize="11.5" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Bildirim Hızı" FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border Background="{StaticResource BrushBgSurface1}" CornerRadius="9" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="RateBtn125" Content="125 Hz" Tag="125" Click="PollingRateBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="28" BorderThickness="0" Margin="0,0,2,0" />
                                        <Button x:Name="RateBtn250" Content="250 Hz" Tag="250" Click="PollingRateBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="28" BorderThickness="0" Margin="0,0,2,0" />
                                        <Button x:Name="RateBtn500" Content="500 Hz" Tag="500" Click="PollingRateBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="28" BorderThickness="0" Margin="0,0,2,0" />
                                        <Button x:Name="RateBtn1000" Content="1000 Hz" Tag="1000" Click="PollingRateBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="28" BorderThickness="0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Interactive Visual DPI Graph Canvas -->
                        <Border Grid.Row="1" Style="{StaticResource StudioCardBorder}" Padding="26,22" Margin="0,0,0,18">
                            <Canvas x:Name="DpiGraphCanvas" Background="Transparent"
                                    SizeChanged="DpiGraphCanvas_SizeChanged"
                                    MouseLeftButtonDown="DpiGraphCanvas_MouseLeftButtonDown"
                                    MouseMove="DpiGraphCanvas_MouseMove"
                                    MouseLeftButtonUp="DpiGraphCanvas_MouseLeftButtonUp" />
                        </Border>

                        <!-- 4 DPI Stage Control Cards -->
                        <UniformGrid x:Name="DpiStagesContainer" Grid.Row="2" Columns="4" />
                    </Grid>

                    <!-- ==================== VIEW 2: LIGHTSYNC & COMPREHENSIVE GAME AMBIENT STUDIO ==================== -->
                    <Grid x:Name="ViewLightingGrid" Grid.Row="0" Visibility="Collapsed" Margin="32,24,32,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="460" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Live 3D Mouse Preview + Real-Time Game Palette & Telemetry -->
                        <Border Grid.Column="0" Style="{StaticResource StudioCardBorder}" Margin="0,0,20,0" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Canlı Önizleme"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Seçili aydınlatma modunun ve geçişlerinin gerçek zamanlı görünümü"
                                               TextWrapping="Wrap"
                                               FontSize="12.5" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                                </StackPanel>

                                <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,8">
                                    <Canvas Width="849" Height="652">
                                        <Ellipse Canvas.Left="130" Canvas.Top="70" Width="500" Height="460">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop x:Name="LightingPreviewGlowStop" Color="#28FFFFFF" Offset="0.0" />
                                                    <GradientStop Color="#00000000" Offset="1.0" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Image x:Name="LightingPreviewBaseImage" Canvas.Left="0" Canvas.Top="0" Width="849" Height="652"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Image x:Name="LightingPreviewSwooshImage" Canvas.Left="268" Canvas.Top="250" Width="271" Height="232"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                        <Image x:Name="LightingPreviewTextureImage" Canvas.Left="268" Canvas.Top="250" Width="270" Height="232"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Canvas>
                                </Viewbox>

                                <!-- Live Color & Cycle Telemetry Box -->
                                <Border Grid.Row="2" Background="{StaticResource BrushBgSurface2}"
                                        CornerRadius="10" Padding="16,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="LiveColorPreviewOrb" Width="14" Height="14" CornerRadius="7"
                                                        Background="{StaticResource BrushAccentCyan}" Margin="0,0,10,0" />
                                                <TextBlock x:Name="LiveTelemetryTitleText" Text="Sabit Donanım Rengi"
                                                           FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="ActiveColorLabel" Text="Turkuaz"
                                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="4" CornerRadius="2" Background="{StaticResource BrushBgCanvas}" ClipToBounds="True">
                                            <Border x:Name="LiveTelemetryProgressFill" HorizontalAlignment="Left" Width="200"
                                                    CornerRadius="2" Background="{StaticResource BrushActiveWhite}" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right: Clean Lighting Mode List & Color Transition Settings -->
                        <Border Grid.Column="1" Style="{StaticResource StudioCardBorder}" Padding="24,22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Aydınlatma &amp; Renk Geçişleri"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Sabit profil rengi, gökkuşağı döngüsü veya renk geçişi ayarlarını yapılandırın"
                                               FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                                </StackPanel>

                                <!-- Clean Borderless List of 3 Modes -->
                                <StackPanel x:Name="LightingModesList" Grid.Row="1" />

                                <!-- Bottom Configuration Controls -->
                                <Border Grid.Row="2" Background="{StaticResource BrushBgSurface2}" CornerRadius="10" Padding="18,16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <!-- Primary & Secondary Color Swatches -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Ana Renk" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                                                <UniformGrid x:Name="LedSwatchesGrid" Columns="8" Height="30" HorizontalAlignment="Left" Width="300" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <TextBlock Text="İkincil Geçiş Rengi" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8" />
                                                <UniformGrid x:Name="SecondaryLedSwatchesGrid" Columns="8" Height="30" HorizontalAlignment="Left" Width="300" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Cycle Speed Slider -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Geçiş Süresi" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                            <Slider x:Name="BreathSpeedSlider" Grid.Column="1" Minimum="1000" Maximum="6000" Value="2800"
                                                    TickFrequency="200" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                    ValueChanged="BreathSpeedSlider_ValueChanged" />
                                            <TextBlock x:Name="BreathSpeedValueText" Grid.Column="2" Text="2.8 sn"
                                                       FontSize="12.5" FontWeight="Medium"
                                                       Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== VIEW 3: MACROS & GAME AUTO-SWITCHER ==================== -->
                    <Grid x:Name="ViewAutomationGrid" Grid.Row="0" Visibility="Collapsed" Margin="32,24,32,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: F13..F18 Host Macro Engine -->
                        <Border Grid.Column="0" Style="{StaticResource StudioCardBorder}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Makro Tanımları (F13–F18)"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Fare tuşlarına atanan F13–F18 tetikleyicilerinin çalıştıracağı eylemler"
                                               FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="MacroItemsPanel" />
                                </ScrollViewer>

                                <Grid Grid.Row="2" Margin="0,14,0,0">
                                    <Button Click="CreateDesktopShortcut_Click" Style="{StaticResource ToolbarActionButton}" HorizontalAlignment="Left"
                                            ToolTip="Masaüstüne Logitech G300s Studio kısayolu ekler">
                                        <TextBlock Text="Masaüstü Kısayolu Oluştur" />
                                    </Button>
                                    <Button Click="SaveDaemonConfig_Click" Style="{StaticResource PrimaryAccentButton}" HorizontalAlignment="Right">
                                        <TextBlock Text="Makroları Kaydet" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Right: Foreground App Auto-Profile Switcher -->
                        <Border Grid.Column="1" Style="{StaticResource StudioCardBorder}" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                    <TextBlock Text="Otomatik Oyun Profili Geçişi"
                                               FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Belirtilen oyun veya uygulama aktif olduğunda ilgili donanım profilini seçer"
                                               FontSize="13" Foreground="{StaticResource BrushTextMuted}" Margin="0,3,0,0" />
                                </StackPanel>

                                <Border Grid.Row="1" Background="{StaticResource BrushBgSurface2}"
                                        CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <CheckBox x:Name="AutoSwitchToggle" Style="{StaticResource PillToggleSwitch}"
                                                      Content="Otomatik Profil Geçişini Etkinleştir"
                                                      Checked="AutoSwitchToggle_Changed" Unchecked="AutoSwitchToggle_Changed"
                                                      VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="Varsayılan:" FontSize="12.5" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox x:Name="DefaultSlotCombo" Width="100" Height="28" SelectionChanged="DefaultSlotCombo_SelectionChanged">
                                                    <ComboBoxItem Content="Profil 1" Tag="0" IsSelected="True" />
                                                    <ComboBoxItem Content="Profil 2" Tag="1" />
                                                    <ComboBoxItem Content="Profil 3" Tag="2" />
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{StaticResource BrushBorderSubtle}" Margin="0,0,0,10" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="OsdToggle" Grid.Column="0" Style="{StaticResource PillToggleSwitch}"
                                                      Content="Ekran Üstü Bildirim (OSD)"
                                                      IsChecked="True"
                                                      Checked="OsdToggle_Changed" Unchecked="OsdToggle_Changed"
                                                      VerticalAlignment="Center" />
                                            <CheckBox x:Name="StartupToggle" Grid.Column="1" Style="{StaticResource PillToggleSwitch}"
                                                      Content="Windows ile Başlat (Tepsi)"
                                                      Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="AppRulesPanel" />
                                </ScrollViewer>

                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NewRuleExeCombo" Grid.Column="0" IsEditable="True" Height="32" Margin="0,0,8,0"
                                              DropDownOpened="NewRuleExeCombo_DropDownOpened"
                                              Text="cs2.exe" />
                                    <ComboBox x:Name="NewRuleSlotCombo" Grid.Column="1" Height="32" Margin="0,0,8,0">
                                        <ComboBoxItem Content="Profil 1" Tag="0" />
                                        <ComboBoxItem Content="Profil 2" Tag="1" IsSelected="True" />
                                        <ComboBoxItem Content="Profil 3" Tag="2" />
                                    </ComboBox>
                                    <Button Grid.Column="2" Click="AddAppRule_Click" Style="{StaticResource ToolbarActionButton}">
                                        <TextBlock Text="+ Ekle" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- SUBTLE FOOTER -->
                    <Border Grid.Row="1" Padding="32,0" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock x:Name="StatusFooterText"
                                       Text="Hazır"
                                       FontSize="11.5" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TelemetryEventText"
                                       Text=""
                                       FontSize="11.5" Foreground="{StaticResource BrushTextSecondary}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="G300sController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logitech G300s Studio — Onboard Memory &amp; Hardware Controller"
        Width="1480" Height="890"
        MinWidth="1220" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgCanvas}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="{StaticResource FontSans}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <!-- ==================== TOP COMMAND BAR ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgSurface1}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Hardware Identity -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="6"
                            Background="{StaticResource BrushAccentCyanSubtle}"
                            BorderBrush="{StaticResource BrushAccentCyanBorder}"
                            BorderThickness="1"
                            Margin="0,0,12,0">
                        <TextBlock Text="G" FontFamily="{StaticResource FontDisplay}"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccentCyan}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="G300s STUDIO"
                                       FontFamily="{StaticResource FontDisplay}"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" />
                            <Border x:Name="ConnectionBadge"
                                    CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                                    Background="{StaticResource BrushSuccessSubtle}"
                                    BorderBrush="#4010B981" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="{StaticResource BrushSuccess}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConnectionStatusText" Text="CONNECTED"
                                               FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushSuccess}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="LgsWarningBadge" Visibility="Collapsed"
                                    CornerRadius="4" Padding="7,2" Margin="6,0,0,0"
                                    Background="{StaticResource BrushWarningSubtle}"
                                    BorderBrush="#50F59E0B" BorderThickness="1"
                                    VerticalAlignment="Center"
                                    ToolTip="Logitech Gaming Software (LCore.exe) is running in the background and may overwrite hardware state.">
                                <TextBlock Text="LGS CONFLICT"
                                           FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushWarning}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DeviceSubHeaderText"
                                   Text="USB 046D:C246 · HID 0xFF80 · EEPROM Ready"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Onboard Profile Slot Switcher -->
                <Border Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"
                        Background="{StaticResource BrushBgCanvas}"
                        BorderBrush="{StaticResource BrushBorderSubtle}"
                        BorderThickness="1" CornerRadius="6" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SlotBtn0" Click="SlotButton_Click" Tag="0"
                                Style="{StaticResource ToolbarActionButton}"
                                Height="30" Padding="12,0" BorderThickness="0" Margin="0,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SlotDot0" Width="8" Height="8" Fill="#FF334B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="SLOT 1" FontFamily="{StaticResource FontDisplay}" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SlotBtn1" Click="SlotButton_Click" Tag="1"
                                Style="{StaticResource ToolbarActionButton}"
                                Height="30" Padding="12,0" BorderThickness="0" Margin="0,0,2,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SlotDot1" Width="8" Height="8" Fill="#00E676" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="SLOT 2" FontFamily="{StaticResource FontDisplay}" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SlotBtn2" Click="SlotButton_Click" Tag="2"
                                Style="{StaticResource ToolbarActionButton}"
                                Height="30" Padding="12,0" BorderThickness="0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SlotDot2" Width="8" Height="8" Fill="#00D4FF" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="SLOT 3" FontFamily="{StaticResource FontDisplay}" FontSize="11.5" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Workspace Mode Switcher -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushBgCanvas}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1" CornerRadius="6" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TabHardwareBtn" Click="WorkspaceTab_Click" Tag="0"
                                    Style="{StaticResource ToolbarActionButton}"
                                    Height="30" Padding="12,0" BorderThickness="0" Margin="0,0,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE962;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Onboard Hardware" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TabDaemonBtn" Click="WorkspaceTab_Click" Tag="1"
                                    Style="{StaticResource ToolbarActionButton}"
                                    Height="30" Padding="12,0" BorderThickness="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Macros &amp; Auto-Switch" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Hardware I/O Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ImportJson_Click" Style="{StaticResource ToolbarActionButton}" Margin="0,0,6,0" ToolTip="Import profile configuration from JSON file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Import" />
                        </StackPanel>
                    </Button>
                    <Button Click="ExportJson_Click" Style="{StaticResource ToolbarActionButton}" Margin="0,0,6,0" ToolTip="Export all 3 profiles to JSON backup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Export" />
                        </StackPanel>
                    </Button>
                    <Button Click="ReloadFromMouse_Click" Style="{StaticResource ToolbarActionButton}" Margin="0,0,8,0" ToolTip="Read current onboard profiles directly from mouse flash">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Read Device" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FlashSaveBtn" Click="SaveToHardware_Click" Style="{StaticResource PrimaryAccentButton}" ToolTip="Write modified profiles to onboard flash memory (with 0xF0 busy lock protection)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="FlashSaveBtnText" Text="Flash to Memory" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN WORKSPACE AREA ==================== -->
        <Grid Grid.Row="1" Margin="16,14,16,10">

            <!-- WORKSPACE 0: HARDWARE & ONBOARD MEMORY -->
            <Grid x:Name="HardwareWorkspaceGrid" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="450" />
                </Grid.ColumnDefinitions>

                <!-- LEFT/CENTER: INTERACTIVE 3D HARDWARE VISUALIZER STAGE -->
                <Border Grid.Column="0" Style="{StaticResource StudioCardBorder}" Padding="0" Margin="0,0,14,0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="46" />
                        </Grid.RowDefinitions>

                        <!-- Stage Top Subbar -->
                        <Border Grid.Row="0" Background="{StaticResource BrushBgSurface2}"
                                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1"
                                Padding="16,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="INTERACTIVE HARDWARE MAP" Style="{StaticResource SectionEyebrowText}" />
                                    <Border CornerRadius="3" Background="{StaticResource BrushBgElevated}" Padding="7,2" Margin="10,0,0,0">
                                        <TextBlock x:Name="StageActiveSlotLabel" Text="SLOT 1 ACTIVE"
                                                   FontFamily="{StaticResource FontMono}" FontSize="10.5"
                                                   Foreground="{StaticResource BrushAccentCyan}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Click any physical button on the mouse or callout badge to configure"
                                           FontSize="11.5" Foreground="{StaticResource BrushTextMuted}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Proportional Vector + Raster Hardware Stage -->
                        <Viewbox Grid.Row="1" Stretch="Uniform" Margin="12,8,12,8">
                            <Canvas x:Name="MouseStageCanvas" Width="1040" Height="610"
                                    Background="Transparent"
                                    MouseMove="MouseStageCanvas_MouseMove"
                                    MouseLeave="MouseStageCanvas_MouseLeave"
                                    MouseLeftButtonDown="MouseStageCanvas_MouseLeftButtonDown">

                                <!-- Subtle Technical Grid Accent Backdrop -->
                                <Ellipse Canvas.Left="290" Canvas.Top="60" Width="480" Height="460"
                                         Fill="#0900C8FF" IsHitTestVisible="False" />

                                <!-- Layer 0: Base 3D Photorealistic G300s (Offset X=135, Y=12) -->
                                <Image x:Name="MouseBaseImage" Canvas.Left="135" Canvas.Top="12" Width="849" Height="652"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                <!-- Layer 1: Live Tinted RGB LED Swoosh (Offset X=135+268=403, Y=12+250=262) -->
                                <Image x:Name="MouseSwooshImage" Canvas.Left="403" Canvas.Top="262" Width="271" Height="232"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                <!-- Layer 2: Honeycomb LED Mesh Texture -->
                                <Image x:Name="MouseSwooshTextureImage" Canvas.Left="403" Canvas.Top="262" Width="270" Height="232"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                <!-- Layer 3: Subtle Ambient Button Rim Glow (Offset X=135+60=195, Y=12-7=5) -->
                                <Image x:Name="MouseAmbientGlowImage" Canvas.Left="195" Canvas.Top="5" Width="558" Height="265"
                                       Opacity="0.45" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                <!-- Layer 4: Hovered Button Specular PulseGlow -->
                                <Image x:Name="HoveredButtonGlowImage" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                <!-- Layer 5: Selected Button Specular PulseGlow + Translucent Fill/Outline -->
                                <Image x:Name="SelectedButtonGlowImage" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                                <Image x:Name="SelectedButtonHighlightImage" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />

                                <!-- Layer 6: Dynamic Vector Leader Lines & Callout Cards (populated in code-behind) -->
                                <Canvas x:Name="OverlayCalloutsCanvas" Width="1040" Height="610" />
                            </Canvas>
                        </Viewbox>

                        <!-- Stage Bottom Telemetry Strip -->
                        <Border Grid.Row="2" Background="{StaticResource BrushBgSurface2}"
                                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0"
                                Padding="16,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="ACTIVE SENSOR:" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TelemetryDpiText" Text="1500 DPI (STAGE 2)" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="REPORT RATE:" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TelemetryRateText" Text="1000 Hz (1.0 ms)" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccentCyan}" />
                                </StackPanel>

                                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LIVE EVENT:" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TelemetryEventText" Grid.Column="1" Text="Listening on 0xFF80 / 0x80..." FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Button Grid.Column="3" Click="ResetProfileDefaults_Click"
                                        Style="{StaticResource ToolbarActionButton}" Height="26" Padding="10,0" FontSize="11"
                                        ToolTip="Reset current profile slot to factory default bindings">
                                    <TextBlock Text="Load Factory Defaults" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- RIGHT COLUMN: CONFIGURATION DOCK -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- CARD 1: SELECTED BUTTON INSPECTOR -->
                        <Border Style="{StaticResource StudioCardBorder}" Padding="14,11" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,9">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" CornerRadius="4"
                                                Background="{StaticResource BrushAccentCyan}" Margin="0,0,10,0">
                                            <TextBlock x:Name="InspectorBtnNumberText" Text="G1"
                                                       FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="Bold"
                                                       Foreground="#050709" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="InspectorBtnTitleText" Text="Primary Left Click"
                                                       FontFamily="{StaticResource FontDisplay}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextPrimary}" />
                                            <TextBlock x:Name="InspectorBtnSubText" Text="Hardware Button Index 0 · 3-Byte HID Descriptor"
                                                       FontFamily="{StaticResource FontMono}" FontSize="10"
                                                       Foreground="{StaticResource BrushTextMuted}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Background="{StaticResource BrushBgSurface2}"
                                            BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                            CornerRadius="4" Padding="8,3">
                                        <TextBlock x:Name="InspectorCurrentActionText" Text="Left Click"
                                                   FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushAccentCyan}" />
                                    </Border>
                                </Grid>

                                <!-- Quick Preset Categories -->
                                <TextBlock Text="MOUSE &amp; NAVIGATION FUNCTIONS" Style="{StaticResource SectionEyebrowText}" Margin="0,0,0,5" />
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="Left Click" Tag="mouse:1" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="0,0,4,4" />
                                    <Button Content="Right Click" Tag="mouse:2" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="2,0,2,4" />
                                    <Button Content="Middle Click" Tag="mouse:3" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="4,0,0,4" />
                                    <Button Content="Back (M4)" Tag="mouse:4" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="0,0,4,0" />
                                    <Button Content="Forward (M5)" Tag="mouse:5" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="2,0,2,0" />
                                    <Button Content="Disable Button" Tag="none" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="4,0,0,0" />
                                </UniformGrid>

                                <TextBlock Text="ONBOARD DPI &amp; PROFILE FUNCTIONS" Style="{StaticResource SectionEyebrowText}" Margin="0,0,0,5" />
                                <UniformGrid Columns="3" Margin="0,0,0,8">
                                    <Button Content="DPI Up" Tag="dpi-up" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="0,0,4,4" />
                                    <Button Content="DPI Down" Tag="dpi-down" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="2,0,2,4" />
                                    <Button Content="DPI Cycle" Tag="dpi-cycle" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="4,0,0,4" />
                                    <Button Content="DPI Shift (Hold)" Tag="dpi-alternate" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="0,0,4,0" />
                                    <Button Content="Default DPI" Tag="dpi-default" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="2,0,2,0" />
                                    <Button Content="Profile Switch" Tag="profile-cycle" Click="QuickActionPreset_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="4,0,0,0" />
                                </UniformGrid>

                                <!-- Keyboard Key & Combination Recorder -->
                                <TextBlock Text="KEYBOARD SHORTCUT OR HOST MACRO TRIGGER" Style="{StaticResource SectionEyebrowText}" Margin="0,0,0,5" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RecordKeyBtn" Grid.Column="0" Click="RecordKeyBtn_Click"
                                            PreviewKeyDown="RecordKeyBtn_PreviewKeyDown"
                                            LostFocus="RecordKeyBtn_LostFocus"
                                            Style="{StaticResource ToolbarActionButton}" Height="28" Padding="10,0" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource FontIcons}" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{StaticResource BrushAccentCyan}" />
                                            <TextBlock x:Name="RecordKeyBtnText" Text="Record Keypress (Ctrl+C, F13...)" FontSize="11.5" />
                                        </StackPanel>
                                    </Button>
                                    <ComboBox x:Name="HostMacroPresetCombo" Grid.Column="1" Width="138" Height="28"
                                              SelectionChanged="HostMacroPresetCombo_SelectionChanged"
                                              ToolTip="Bind to F13..F18 high function keys for Host Daemon macros">
                                        <ComboBoxItem Content="Host Macro..." IsSelected="True" IsEnabled="False" />
                                        <ComboBoxItem Content="Macro 1 (F13)" Tag="key:f13" />
                                        <ComboBoxItem Content="Macro 2 (F14)" Tag="key:f14" />
                                        <ComboBoxItem Content="Macro 3 (F15)" Tag="key:f15" />
                                        <ComboBoxItem Content="Macro 4 (F16)" Tag="key:f16" />
                                        <ComboBoxItem Content="Macro 5 (F17)" Tag="key:f17" />
                                        <ComboBoxItem Content="Macro 6 (F18)" Tag="key:f18" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: SENSOR & 4 ONBOARD DPI STAGES -->
                        <Border Style="{StaticResource StudioCardBorder}" Padding="14,11" Margin="0,0,0,9">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="SENSOR &amp; DPI STAGES" Style="{StaticResource SectionEyebrowText}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Click S1–S4 to activate · ★ Boot default"
                                               FontSize="10.5" Foreground="{StaticResource BrushTextMuted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Polling Rate Segmented Bar -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="USB Polling Rate:" FontSize="11.5"
                                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <UniformGrid Grid.Column="1" Columns="4">
                                        <Button x:Name="RateBtn125" Content="125 Hz" Tag="125" Click="PollingRateBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="0,0,3,0" />
                                        <Button x:Name="RateBtn250" Content="250 Hz" Tag="250" Click="PollingRateBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="2,0,2,0" />
                                        <Button x:Name="RateBtn500" Content="500 Hz" Tag="500" Click="PollingRateBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="2,0,2,0" />
                                        <Button x:Name="RateBtn1000" Content="1000 Hz" Tag="1000" Click="PollingRateBtn_Click" Style="{StaticResource ToolbarActionButton}" Height="26" FontSize="11.5" Margin="3,0,0,0" />
                                    </UniformGrid>
                                </Grid>

                                <!-- 4 DPI Stage Rows -->
                                <StackPanel x:Name="DpiStagesContainer" />
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: SIDE ILLUMINATION & LIVE RAM EFFECTS -->
                        <Border Style="{StaticResource StudioCardBorder}" Padding="14,11">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="SIDE ILLUMINATION (3-BIT RGB &amp; RAM)" Style="{StaticResource SectionEyebrowText}" />
                                    <TextBlock x:Name="ActiveColorLabel" Text="Logitech Cyan"
                                               FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccentCyan}" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- 8 Hardware Color Swatches -->
                                <UniformGrid x:Name="LedSwatchesGrid" Columns="8" Height="30" Margin="0,0,0,8" />

                                <!-- Software Live RAM Effect Selector -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Live RAM Effect (0xF1):" FontSize="11.5"
                                               Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox x:Name="RgbEffectCombo" Grid.Column="1" Height="28"
                                              SelectionChanged="RgbEffectCombo_SelectionChanged">
                                        <ComboBoxItem Content="Hardware Profile Static (Zero CPU)" Tag="none" IsSelected="True" />
                                        <ComboBoxItem Content="Spectrum 7-Color Cycle (RAM 0xF1)" Tag="cycle" />
                                        <ComboBoxItem Content="Breathing Pulse (RAM 0xF1)" Tag="breathing" />
                                        <ComboBoxItem Content="Emergency Red/Blue Strobe (RAM 0xF1)" Tag="police" />
                                        <ComboBoxItem Content="CPU Load Reactive Telemetry (Green/Amber/Red)" Tag="cpu" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- WORKSPACE 1: HOST MACROS & AUTO-PROFILE SWITCHER -->
            <Grid x:Name="DaemonWorkspaceGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: F13..F18 Host Macro Engine -->
                <Border Grid.Column="0" Style="{StaticResource StudioCardBorder}" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="HOST MACRO ENGINE (WH_KEYBOARD_LL + SENDINPUT)" Style="{StaticResource SectionEyebrowText}" />
                            <TextBlock Text="Bypass the G300s 1-key hardware limit by mapping any mouse button to F13–F18. The low-level hook intercepts F13–F18 with zero key conflicts."
                                       FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MacroItemsPanel" />
                        </ScrollViewer>

                        <Button Grid.Row="2" Click="SaveDaemonConfig_Click" Style="{StaticResource PrimaryAccentButton}" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="{StaticResource FontIcons}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Save Host Macro Configuration" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Right: Foreground App Auto-Profile Switcher -->
                <Border Grid.Column="1" Style="{StaticResource StudioCardBorder}" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FOREGROUND APPLICATION AUTO-PROFILE SWITCHER" Style="{StaticResource SectionEyebrowText}" />
                                <TextBlock Text="Automatically switches the active onboard hardware slot (0xF0) when a matching game or studio app is focused."
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="{StaticResource BrushBgSurface2}"
                                BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1"
                                CornerRadius="4" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <CheckBox x:Name="AutoSwitchToggle" Content="Enable Active Window Auto-Profile Switching"
                                          Checked="AutoSwitchToggle_Changed" Unchecked="AutoSwitchToggle_Changed"
                                          Foreground="{StaticResource BrushTextPrimary}" FontWeight="Medium" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Default Slot:" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="DefaultSlotCombo" Width="100" Height="28" SelectionChanged="DefaultSlotCombo_SelectionChanged">
                                        <ComboBoxItem Content="Slot 1" Tag="0" IsSelected="True" />
                                        <ComboBoxItem Content="Slot 2" Tag="1" />
                                        <ComboBoxItem Content="Slot 3" Tag="2" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AppRulesPanel" />
                        </ScrollViewer>

                        <!-- Add New App Rule Row -->
                        <Grid Grid.Row="3" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="NewRuleExeCombo" Grid.Column="0" IsEditable="True" Height="32" Margin="0,0,8,0"
                                      DropDownOpened="NewRuleExeCombo_DropDownOpened"
                                      Text="cs2.exe" />
                            <ComboBox x:Name="NewRuleSlotCombo" Grid.Column="1" Height="32" Margin="0,0,8,0">
                                <ComboBoxItem Content="Slot 1" Tag="0" />
                                <ComboBoxItem Content="Slot 2" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="Slot 3" Tag="2" />
                            </ComboBox>
                            <Button Grid.Column="2" Click="AddAppRule_Click" Style="{StaticResource ToolbarActionButton}">
                                <TextBlock Text="+ Add Rule" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBgSurface1}"
                BorderBrush="{StaticResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="20,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusFooterText"
                               Text="Ready · All 3 onboard profiles synchronized with hardware flash."
                               FontSize="11.5"
                               Foreground="{StaticResource BrushTextSecondary}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="RawHexPreviewText"
                               Text="0xF3: F3 05 00 04 06 07 89 40 ..."
                               FontFamily="{StaticResource FontMono}"
                               FontSize="10.5"
                               Foreground="{StaticResource BrushTextMuted}"
                               Margin="0,0,16,0" VerticalAlignment="Center" />
                    <Button Click="MinimizeToTray_Click" Style="{StaticResource ToolbarActionButton}" Height="24" Padding="10,0" FontSize="11">
                        <TextBlock Text="Minimize to System Tray" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

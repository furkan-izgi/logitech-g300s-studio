                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NewRuleExeCombo" Grid.Column="0" IsEditable="True" Height="32" Margin="0,0,8,0"
                                              DropDownOpened="NewRuleExeCombo_DropDownOpened"

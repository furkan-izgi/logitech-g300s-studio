<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         MATTE CARBON & PURE WHITE INDUSTRIAL DESIGN SYSTEM (Zero AI-Slop Palette)
         ========================================================================= -->

    <!-- Neutral Matte Carbon Surfaces (Zinc / Graphite scale) -->
    <Color x:Key="ColorBgCanvas">#09090B</Color>
    <Color x:Key="ColorBgRail">#0E0E11</Color>
    <Color x:Key="ColorBgSurface1">#141418</Color>
    <Color x:Key="ColorBgSurface2">#1C1C22</Color>
    <Color x:Key="ColorBgElevated">#26262E</Color>

    <SolidColorBrush x:Key="BrushBgCanvas" Color="{StaticResource ColorBgCanvas}" />
    <SolidColorBrush x:Key="BrushBgRail" Color="{StaticResource ColorBgRail}" />
    <SolidColorBrush x:Key="BrushBgSurface1" Color="{StaticResource ColorBgSurface1}" />
    <SolidColorBrush x:Key="BrushBgSurface2" Color="{StaticResource ColorBgSurface2}" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />

    <!-- Subtle Hairline Dividers -->
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#24FFFFFF" />

    <!-- Clean Neutral Typography -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#FAFAFA" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#A1A1AA" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#63636E" />

    <!-- High-Contrast White Active State & Subtle Cyan Hardware Accent -->
    <SolidColorBrush x:Key="BrushActiveWhite" Color="#F4F4F6" />
    <SolidColorBrush x:Key="BrushAccentCyan" Color="#00C8FF" />
    <SolidColorBrush x:Key="BrushAccentCyanHover" Color="#38BDF8" />
    <SolidColorBrush x:Key="BrushAccentCyanSubtle" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="BrushAccentCyanBorder" Color="#38FFFFFF" />

    <!-- Semantic Indicators -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#22C55E" />
    <SolidColorBrush x:Key="BrushSuccessSubtle" Color="#1A22C55E" />
    <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
    <SolidColorBrush x:Key="BrushWarningSubtle" Color="#1FF59E0B" />
    <SolidColorBrush x:Key="BrushDanger" Color="#EF4444" />

    <!-- Unified Clean Typography (Zero Monospace Slop) -->
    <FontFamily x:Key="FontSans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Matte Studio Panel -->
    <Style x:Key="StudioCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface1}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Left Navigation Rail Item -->
    <Style x:Key="NavRailButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextMuted}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="54" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgSurface2}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Matte Pill Button -->
    <Style x:Key="ToolbarActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgElevated}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- High-Contrast White Primary CTA Button -->
    <Style x:Key="PrimaryAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushActiveWhite}" />
        <Setter Property="Foreground" Value="#09090B" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,5" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Caption Button -->
    <Style x:Key="WindowCaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgSurface2}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless Clean List Row Button -->
    <Style x:Key="ActionRowButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgSurface2}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small Step Button -->
    <Style x:Key="StepIconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushBgElevated}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Pill Toggle Switch (Replaces Square CheckBox) -->
    <Style x:Key="PillToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="SwitchTrack"
                                Width="38" Height="20"
                                CornerRadius="10"
                                Background="{StaticResource BrushBgElevated}"
                                Padding="2"
                                Margin="0,0,10,0">
                            <Ellipse x:Name="SwitchThumb"
                                     Width="16" Height="16"
                                     Fill="{StaticResource BrushTextSecondary}"
                                     HorizontalAlignment="Left" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource BrushActiveWhite}" />
                            <Setter TargetName="SwitchThumb" Property="Fill" Value="#09090B" />
                            <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Minimalist Slider -->
    <Style TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource BrushBgElevated}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16"
                                                     Fill="{StaticResource BrushActiveWhite}"
                                                     Stroke="#09090B"
                                                     StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

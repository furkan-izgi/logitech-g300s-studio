<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Core Palette Colors -->
    <Color x:Key="ColorBgCanvas">#0B0D10</Color>
    <Color x:Key="ColorBgSurface1">#111419</Color>
    <Color x:Key="ColorBgSurface2">#171B22</Color>
    <Color x:Key="ColorBgElevated">#1E232C</Color>
    <Color x:Key="ColorBgInteractive">#252B36</Color>
    <Color x:Key="ColorBorderSubtle">#232933</Color>
    <Color x:Key="ColorBorderStrong">#323A47</Color>
    <Color x:Key="ColorAccentCyan">#00C8FF</Color>
    <Color x:Key="ColorAccentCyanHover">#26D3FF</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBgCanvas" Color="{StaticResource ColorBgCanvas}" />
    <SolidColorBrush x:Key="BrushBgSurface1" Color="{StaticResource ColorBgSurface1}" />
    <SolidColorBrush x:Key="BrushBgSurface2" Color="{StaticResource ColorBgSurface2}" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />
    <SolidColorBrush x:Key="BrushBgInteractive" Color="{StaticResource ColorBgInteractive}" />
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="{StaticResource ColorBorderSubtle}" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />

    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#94A3B8" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B" />

    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentCyanHover" Color="{StaticResource ColorAccentCyanHover}" />
    <SolidColorBrush x:Key="BrushAccentCyanSubtle" Color="#1F00C8FF" />
    <SolidColorBrush x:Key="BrushAccentCyanBorder" Color="#6600C8FF" />

    <SolidColorBrush x:Key="BrushSuccess" Color="#10B981" />
    <SolidColorBrush x:Key="BrushSuccessSubtle" Color="#1A10B981" />
    <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
    <SolidColorBrush x:Key="BrushWarningSubtle" Color="#1AF59E0B" />
    <SolidColorBrush x:Key="BrushDanger" Color="#EF4444" />

    <!-- Typography Families -->
    <FontFamily x:Key="FontSans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Studio Card Container Style -->
    <Style x:Key="StudioCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface1}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Section Eyebrow Header -->
    <Style x:Key="SectionEyebrowText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Secondary Toolbar Button -->
    <Style x:Key="ToolbarActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgElevated}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgInteractive}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Accent Action Button -->
    <Style x:Key="PrimaryAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccentCyan}" />
        <Setter Property="Foreground" Value="#06080A" />
        <Setter Property="BorderBrush" Value="#00E1FF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushAccentCyanHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="#00A8D6" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small Step Button (- / +) -->
    <Style x:Key="StepIconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgInteractive}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

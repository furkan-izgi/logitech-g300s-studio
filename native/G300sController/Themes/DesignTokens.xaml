<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================================
         G300s FLAGSHIP STUDIO DESIGN TOKENS (Deep Obsidian & Electric Cyan)
         ========================================================================= -->

    <!-- Core Background Hierarchy -->
    <Color x:Key="ColorBgCanvas">#08090D</Color>
    <Color x:Key="ColorBgRail">#0C0E14</Color>
    <Color x:Key="ColorBgSurface1">#11141C</Color>
    <Color x:Key="ColorBgSurface2">#171B26</Color>
    <Color x:Key="ColorBgElevated">#1F2433</Color>

    <SolidColorBrush x:Key="BrushBgCanvas" Color="{StaticResource ColorBgCanvas}" />
    <SolidColorBrush x:Key="BrushBgRail" Color="{StaticResource ColorBgRail}" />
    <SolidColorBrush x:Key="BrushBgSurface1" Color="{StaticResource ColorBgSurface1}" />
    <SolidColorBrush x:Key="BrushBgSurface2" Color="{StaticResource ColorBgSurface2}" />
    <SolidColorBrush x:Key="BrushBgElevated" Color="{StaticResource ColorBgElevated}" />

    <!-- Hairline Borders -->
    <SolidColorBrush x:Key="BrushBorderSubtle" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="BrushBorderStrong" Color="#26FFFFFF" />

    <!-- Typography Hierarchy -->
    <SolidColorBrush x:Key="BrushTextPrimary" Color="#F3F6FA" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="#94A3B8" />
    <SolidColorBrush x:Key="BrushTextMuted" Color="#596579" />

    <!-- Brand Accent: Logitech Electric Cyan -->
    <Color x:Key="ColorAccentCyan">#00C8FF</Color>
    <SolidColorBrush x:Key="BrushAccentCyan" Color="{StaticResource ColorAccentCyan}" />
    <SolidColorBrush x:Key="BrushAccentCyanHover" Color="#33D6FF" />
    <SolidColorBrush x:Key="BrushAccentCyanSubtle" Color="#1F00C8FF" />
    <SolidColorBrush x:Key="BrushAccentCyanBorder" Color="#6600C8FF" />

    <!-- Semantic Status -->
    <SolidColorBrush x:Key="BrushSuccess" Color="#10B981" />
    <SolidColorBrush x:Key="BrushSuccessSubtle" Color="#1A10B981" />
    <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B" />
    <SolidColorBrush x:Key="BrushWarningSubtle" Color="#1FF59E0B" />
    <SolidColorBrush x:Key="BrushDanger" Color="#F43F5E" />

    <!-- Font Families -->
    <FontFamily x:Key="FontSans">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Sleek Surface Panel -->
    <Style x:Key="StudioCardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface1}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Left Navigation Rail Button -->
    <Style x:Key="NavRailButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="58" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgSurface2}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Action Pill / Button -->
    <Style x:Key="ToolbarActionButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgElevated}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource BrushBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushAccentCyanSubtle}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary CTA Button (Electric Cyan) -->
    <Style x:Key="PrimaryAccentButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushAccentCyan}" />
        <Setter Property="Foreground" Value="#04080C" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,4" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushAccentCyanHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Opacity" Value="0.88" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Caption Button -->
    <Style x:Key="WindowCaptionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgSurface2}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- List Action Row Button (for clean drawer assignment list) -->
    <Style x:Key="ActionRowButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgSurface2}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource BrushBgElevated}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource BrushAccentCyanBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small Circular/Square Step Button -->
    <Style x:Key="StepIconButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BrushBgElevated}" />
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushAccentCyanSubtle}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushAccentCyan}" />
                            <Setter Property="Foreground" Value="{StaticResource BrushAccentCyan}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

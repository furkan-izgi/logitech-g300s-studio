# Logitech G300s Optical Gaming Mouse (046D:C246)
# Grants read/write access to user session for onboard memory & vendor HID reports (usage page 0xFF80)

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c246", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c246", MODE="0666", TAG+="uaccess"
